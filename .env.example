# Kopieren nach .env und Werte lokal anpassen. .env darf NIE committet werden.
DATABASE_URL="postgresql://app_user:app_password@localhost:5432/ki_cross?schema=public"
NODE_ENV="development"

# Platzhalter fuer Entwicklungs-Authentifizierung (siehe docs/PRIVACY_AND_SECURITY.md).
# NICHT produktionsreif. Kein oeffentliches Deployment mit Mock-Auth.
DEV_AUTH_SECRET="change-me-in-local-env-only"

# Konfigurierbarer Schwellenwert fuer Wiedervorlage bei Vertragsende (Tage).
# Seed-Standardwert gemaess Entscheidung #11 (ChatGPT-Projektleiter-Review): 180 Tage.
# Muss ueber ConfigurableThreshold in der DB pflegbar sein, nicht im Code hartkodiert.
RENEWAL_LOOKAHEAD_DAYS_DEFAULT="180"
